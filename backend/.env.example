# ============================================================
# MenstrualCycle Backend — Environment Variables
# Copy this file to .env and fill in your real values
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── MySQL Database ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=mc_user
DB_PASSWORD=your_mysql_password_here
DB_NAME=menstrual_cycle_db

# ── JWT Secrets ──────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here_minimum_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_minimum_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Twilio (SMS OTP) ────────────────────────────────────────
# Get from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ── Gmail SMTP (Email OTP via Nodemailer) ────────────────────
# Get App Password from: Google Account → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="MenstrualCycle <your_email@gmail.com>"

# ── Apple Sign-In (OAuth2) ──────────────────────────────────
# Get from: https://developer.apple.com/account/
APPLE_CLIENT_ID=com.arceus.MenstrualCycle
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY_PATH=./config/AuthKey.p8

# ── Facebook Login ──────────────────────────────────────────
# Get from: https://developers.facebook.com/apps/
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
